---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Proyectos | Tetute"
  description="Proyectos de desarrollo, programación, sistemas y redes de Tetute."
>
  <section class="page-intro">
    <p class="eyebrow">Mi trabajo y aprendizaje</p>
    <h1>Proyectos.</h1>
    <p class="lead">
      Aquí iré reuniendo proyectos terminados, pruebas y experimentos. Cada tarjeta puede tener
      una imagen, una explicación, las tecnologías utilizadas y un enlace al código o a una demo.
    </p>
  </section>

  <section aria-label="Listado de proyectos">
    <div class="project-tools">
      <div class="filter-list" aria-label="Filtrar proyectos">
        <button class="filter-button" type="button" data-filter="all" aria-pressed="true">Todos</button>
        <button class="filter-button" type="button" data-filter="web" aria-pressed="false">Web</button>
        <button class="filter-button" type="button" data-filter="homelab" aria-pressed="false">Homelab</button>
        <button class="filter-button" type="button" data-filter="python" aria-pressed="false">Programación</button>
      </div>
      <span class="project-count" data-project-count>4 proyectos</span>
    </div>

    <div class="project-grid">
      <article class="project-card" data-project data-category="homelab" id="homelab">
        <div class="project-image">
          <!-- Sustituye el SVG por tu foto: /images/homelab.jpg -->
          <img src="/images/homelab-placeholder.svg" alt="Ilustración de servidores en un laboratorio doméstico" loading="lazy" />
        </div>
        <div class="project-card-body">
          <p class="card-kicker">Sistemas y redes</p>
          <h3>Mi homelab</h3>
          <p>Virtualización, redes segmentadas y servicios propios para practicar administración de sistemas.</p>
          <ul class="tag-list" aria-label="Tecnologías"><li>Proxmox</li><li>Linux</li><li>OpenWrt</li></ul>
          <div class="project-card-footer">
            <span class="project-tag">En evolución</span>
            <a class="text-link" href="/servicios/">Ver servicios ↗</a>
          </div>
        </div>
      </article>

      <article class="project-card" data-project data-category="web" id="portfolio">
        <div class="project-image">
          <!-- Sustituye el SVG por una captura de tu web: /images/portfolio.jpg -->
          <img src="/images/web-placeholder.svg" alt="Ilustración de una página web sencilla" loading="lazy" />
        </div>
        <div class="project-card-body">
          <p class="card-kicker">Desarrollo web</p>
          <h3>Mi portfolio</h3>
          <p>Una web personal creada para practicar desarrollo web, control de versiones y despliegue automático.</p>
          <ul class="tag-list" aria-label="Tecnologías"><li>HTML</li><li>CSS</li><li>Astro</li></ul>
          <div class="project-card-footer">
            <span class="project-tag">En desarrollo</span>
            <a class="text-link" href="https://github.com/Tetute0025/mi-portfolio" target="_blank" rel="noreferrer">Ver repositorio ↗</a>
          </div>
        </div>
      </article>

      <article class="project-card" data-project data-category="python" id="automatizacion">
        <div class="project-image">
          <!-- Cambia la imagen cuando tengas una captura del programa. -->
          <img src="/images/code-placeholder.svg" alt="Ilustración de código en una terminal" loading="lazy" />
        </div>
        <div class="project-card-body">
          <p class="card-kicker">Programación</p>
          <h3>Scripts y automatización</h3>
          <p>Pequeñas herramientas para resolver tareas repetitivas y experimentar con Python.</p>
          <ul class="tag-list" aria-label="Tecnologías"><li>Python</li><li>CLI</li></ul>
          <div class="project-card-footer">
            <span class="project-tag">Por desarrollar</span>
            <span class="muted">Repositorio pendiente</span>
          </div>
        </div>
      </article>

      <article class="project-card" data-project data-category="homelab" id="dns">
        <div class="project-image">
          <img src="/images/network-placeholder.svg" alt="Ilustración de una red de dispositivos conectados" loading="lazy" />
        </div>
        <div class="project-card-body">
          <p class="card-kicker">Infraestructura</p>
          <h3>Red y DNS de laboratorio</h3>
          <p>Documentación de los experimentos de red, resolución de nombres y acceso privado.</p>
          <ul class="tag-list" aria-label="Tecnologías"><li>DNS</li><li>VLAN</li><li>Redes</li></ul>
          <div class="project-card-footer">
            <span class="project-tag">Documentación pendiente</span>
            <a class="text-link" href="/servicios/">Ver homelab ↗</a>
          </div>
        </div>
      </article>
    </div>
  </section>
</Layout>
