---
interface Props {
  number: string;
  category: string;
  title: string;
  description: string;
  tags: string[];
  status: string;
}

const {
  number,
  category,
  title,
  description,
  tags,
  status
} = Astro.props;
---

    <article class="project-card">
    <div class="project-top">
        <span class="project-number">{number}</span>
        <span class="project-icon" aria-hidden="true">⌘</span>
    </div>

    <p class="project-category">{category}</p>
    <h3>{title}</h3>
    <p class="project-description">{description}</p>

    <div class="project-tags">
        {tags.map((tag) => <span>{tag}</span>)}
    </div>

    <span class="project-status">{status} ↗</span>
    </article>

    <style>
    .project-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        min-height: 340px;
        padding: 24px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: linear-gradient(145deg, #12151d, #0e1016);
        transition: border-color 0.2s, transform 0.2s;
    }

    .project-card:hover {
        transform: translateY(-4px);
        border-color: #617747;
    }

    .project-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
    }

    .project-number {
        color: #858c9d;
        font-family: monospace;
        font-size: 0.85rem;
    }

    .project-icon {
        display: grid;
        width: 39px;
        height: 39px;
        place-items: center;
        border: 1px solid #343a47;
        border-radius: 9px;
        color: var(--green);
        font-size: 1.25rem;
    }

    .project-category {
        margin-top: 28px;
        color: var(--green);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 1.3px;
    }

    .project-description {
        margin: 0 0 20px;
        color: var(--muted);
        font-size: 0.88rem;
        line-height: 1.8;
    }

    .project-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .project-tags span {
        padding: 6px 8px;
        border: 1px solid #2b303b;
        border-radius: 6px;
        background: #11141b;
        color: #c0c6d3;
        font-size: 0.7rem;
    }

    .project-status {
        margin-top: auto;
        padding-top: 24px;
        color: #c5cbd7;
        font-size: 0.8rem;
    }

    @media (max-width: 600px) {
        .project-card {
        min-height: 300px;
        }
    }
    </style>