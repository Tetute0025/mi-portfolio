---
import "../styles/global.css";

const {
  title = "Tetute | Portfolio",
  description = "Portfolio personal de Tetute: desarrollo, sistemas y proyectos de informática.",
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101411" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <div class="site-shell">
      <header class="site-header">
        <div class="container nav-wrap">
          <a class="brand" href="/" aria-label="Tetute, inicio">
            tetute<span>.</span>
          </a>

          <button
            class="nav-toggle"
            type="button"
            data-menu-toggle
            aria-controls="site-nav"
            aria-expanded="false"
            aria-label="Abrir menú de navegación"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>

          <nav class="site-nav" id="site-nav" aria-label="Navegación principal">
            <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>Inicio</a>
            <a href="/proyectos/" aria-current={currentPath.startsWith("/proyectos") ? "page" : undefined}>Proyectos</a>
            <a href="/servicios/" aria-current={currentPath.startsWith("/servicios") ? "page" : undefined}>Mi homelab</a>
            <a class="nav-github" href="https://github.com/Tetute0025" target="_blank" rel="noreferrer">GitHub ↗</a>
          </nav>
        </div>
      </header>

      <main id="contenido" class="container">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="container footer-content">
          <a class="brand footer-brand" href="/">tetute<span>.</span></a>
          <p>Hecho con curiosidad y ganas de aprender.</p>
          <span>© <span data-current-year>2026</span> Tetute</span>
        </div>
      </footer>
    </div>

    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
